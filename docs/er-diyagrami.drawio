<mxfile host="app.diagrams.net"><diagram name="er-diyagrami" id="er-diyagrami"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Users" style="swimlane;fontStyle=1;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="290" height="300" as="geometry"/></mxCell><mxCell id="c3" value="PK  Id : int&lt;br&gt;Discriminator : text (Student / AdminUser)&lt;br&gt;Email : text&lt;br&gt;PasswordHash : text&lt;br&gt;Role : text&lt;br&gt;FailedLoginCount : int&lt;br&gt;LockedUntil : datetime (null olabilir)&lt;br&gt;— yalnızca Student satırlarında —&lt;br&gt;AdSoyad, TcKimlikNo, Uyruk : text&lt;br&gt;OgrenciNo : text&lt;br&gt;DogumTarihi : datetime&lt;br&gt;Adres, Bolum, Telefon : text&lt;br&gt;OncekiStajGunSayisi : int&lt;br&gt;Ek16TeslimYili : text&lt;br&gt;SaglikYardimiStatusu : text" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;html=1;fontSize=11;" vertex="1" parent="c2"><mxGeometry y="26" width="290" height="270" as="geometry"/></mxCell><mxCell id="c4" value="Documents" style="swimlane;fontStyle=1;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="20" width="290" height="300" as="geometry"/></mxCell><mxCell id="c5" value="PK  Id : int&lt;br&gt;FK  StudentId : int → Users.Id&lt;br&gt;FilePath, FileType : text&lt;br&gt;UploadedAt : datetime&lt;br&gt;CompletedAt : datetime (null olabilir)&lt;br&gt;Status : int (DocumentStatus)&lt;br&gt;OgrenciAdSoyad, TcKimlikNo, Uyruk : text&lt;br&gt;OgretimYili : text&lt;br&gt;StajBaslangic, StajBitis : datetime&lt;br&gt;Telefon, Eposta, Adres : text&lt;br&gt;MuhendisSayisi : int&lt;br&gt;MuhendisBolumu : text&lt;br&gt;HaftalikGunler : text&lt;br&gt;BelgedekiGunSayisi : int&lt;br&gt;HesaplananGunSayisi : int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;html=1;fontSize=11;" vertex="1" parent="c4"><mxGeometry y="26" width="290" height="270" as="geometry"/></mxCell><mxCell id="c6" value="ValidationReports" style="swimlane;fontStyle=1;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="820" y="20" width="250" height="84" as="geometry"/></mxCell><mxCell id="c7" value="PK  Id : int&lt;br&gt;FK  DocumentId : int → Documents.Id&lt;br&gt;CreatedAt : datetime" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;html=1;fontSize=11;" vertex="1" parent="c6"><mxGeometry y="26" width="250" height="54" as="geometry"/></mxCell><mxCell id="c8" value="ValidationIssues" style="swimlane;fontStyle=1;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="820" y="180" width="250" height="120" as="geometry"/></mxCell><mxCell id="c9" value="PK  Id : int&lt;br&gt;FK  ValidationReportId : int → ValidationReports.Id&lt;br&gt;ReportId : int&lt;br&gt;FieldName : text&lt;br&gt;Message : text" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;html=1;fontSize=11;" vertex="1" parent="c8"><mxGeometry y="26" width="250" height="90" as="geometry"/></mxCell><mxCell id="c10" value="LoginAttempts" style="swimlane;fontStyle=1;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="290" height="120" as="geometry"/></mxCell><mxCell id="c11" value="PK  Id : int&lt;br&gt;Email : text (Users tablosuna FK yok)&lt;br&gt;Success : bool&lt;br&gt;AttemptedAt : datetime&lt;br&gt;IpAddress : text (null olabilir)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;html=1;fontSize=11;" vertex="1" parent="c10"><mxGeometry y="26" width="290" height="90" as="geometry"/></mxCell><mxCell id="c12" value="Notlar: EF Core kalıtımı tek tabloyla saklar (TPH): AppUser, Student ve AdminUser tek Users tablosundadır, Discriminator sütunu hangi türden olduğunu söyler. Status sayı olarak saklanır (Yuklendi=0 … Tamamlandi=4). Uyarı: ValidationIssues için ReportId ile ValidationReportId iki ayrı sütun olabilir, AddDocuments migration dosyasına bakarak doğrulayın." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="640" height="90" as="geometry"/></mxCell><mxCell id="c13" value="N — 1" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#333333;html=1;" edge="1" parent="1" source="c4" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="N — 1" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#333333;html=1;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="N — 1" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#333333;html=1;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>