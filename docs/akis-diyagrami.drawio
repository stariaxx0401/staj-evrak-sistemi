<mxfile host="app.diagrams.net"><diagram name="akis-diyagrami" id="akis-diyagrami"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Başla" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="20" width="90" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Öğrenci Ek-16 dosyasını yükler ve belgedeki bilgileri forma girer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="300" height="56" as="geometry"/></mxCell><mxCell id="c4" value="Dosya türü geçerli mi? (.doc .docx .pdf .jpg .jpeg .png)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="190" width="300" height="100" as="geometry"/></mxCell><mxCell id="c5" value="Hata mesajı: bu dosya türü desteklenmiyor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="212" width="260" height="56" as="geometry"/></mxCell><mxCell id="c6" value="Dosya kaydedilir, belge oluşturulur: durum Yüklendi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="326" width="300" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Durum: İnceleniyor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="418" width="300" height="56" as="geometry"/></mxCell><mxCell id="c8" value="Belgedeki ad, TC ve uyruk öğrenci kaydıyla karşılaştırılır" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="510" width="300" height="56" as="geometry"/></mxCell><mxCell id="c9" value="Doğrulayıcılar çalıştırılır: TC, telefon, e-posta, adres, mühendis, öğretim yılı, 30 gün, staj günü" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="602" width="300" height="76" as="geometry"/></mxCell><mxCell id="c10" value="Sorun var mı?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="714" width="300" height="100" as="geometry"/></mxCell><mxCell id="c11" value="Durum: Hatalı/Eksik, rapor sorunları listeler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="736" width="260" height="56" as="geometry"/></mxCell><mxCell id="c12" value="Öğrenci düzeltip belgeyi yeniden yükler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="630" width="260" height="56" as="geometry"/></mxCell><mxCell id="c13" value="Durum: Onaylandı, rapor temiz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="850" width="300" height="56" as="geometry"/></mxCell><mxCell id="c14" value="Admin başvuruyu listeden açıp raporu inceler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="942" width="300" height="56" as="geometry"/></mxCell><mxCell id="c15" value="Admin Tamamla düğmesine basar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="1034" width="300" height="56" as="geometry"/></mxCell><mxCell id="c16" value="Durum: Tamamlandı (öğrenci değiştiremez, sadece admin değiştirir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b3