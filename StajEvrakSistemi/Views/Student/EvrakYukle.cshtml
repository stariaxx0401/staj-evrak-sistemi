<h2>Ek-16 Yükle</h2>

<div class="row">
    <div class="col-md-6">
        @* enctype="multipart/form-data": dosya göndermek için şart, yoksa dosya sunucuya gelmiyor *@
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">Ek-16 belgesi (Word, PDF, JPEG veya PNG)</label>

                @* name="dosya": Kişi 2'nin yazacağı metottaki parametre adıyla aynı olmalı *@
                @* accept: dosya seçme penceresinde sadece bu türleri gösteriyor, asıl kontrolü sunucu yapacak *@
                <input type="file" name="dosya" class="form-control"
                       accept=".doc,.docx,.pdf,.jpg,.jpeg,.png" required />
            </div>
            <button type="submit" class="btn btn-primary">Evrak Yükle</button>
        </form>

        @* sunucudan gelen hata ya da bilgi mesajı burada gösterilecek *@
        @if (TempData["Mesaj"] != null)
        {
            <div class="alert alert-info mt-3">@TempData["Mesaj"]</div>
        }
    </div>
</div>