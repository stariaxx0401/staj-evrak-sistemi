@model StajEvrakSistemi.Models.EvrakYukleViewModel

<h2>Ek-16 Yükle</h2>

<div class="row">
    <div class="col-md-7">
        @* enctype="multipart/form-data": dosya göndermek için şart *@
        <form method="post" enctype="multipart/form-data">
            @* hata mesajları burada çıkıyor *@
            <div asp-validation-summary="All" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label class="form-label">Ek-16 belgesi (Word, PDF, JPEG veya PNG)</label>
                <input asp-for="Dosya" class="form-control" accept=".doc,.docx,.pdf,.jpg,.jpeg,.png" />
            </div>

            <h5>Belgede yazan bilgiler</h5>
            <div class="mb-2"><label class="form-label">Ad Soyad</label><input asp-for="AdSoyad" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">TC / Yabancı kimlik no</label><input asp-for="TcKimlikNo" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Uyruk (T.C. veya Yabancı)</label><input asp-for="Uyruk" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Öğretim yılı ve yarıyıl (örn. 2025-2026 Bahar)</label><input asp-for="OgretimYili" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Staj başlangıç tarihi</label><input asp-for="StajBaslangic" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Staj bitiş tarihi</label><input asp-for="StajBitis" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Telefon (+90 xxx xxx xx xx)</label><input asp-for="Telefon" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">E-posta</label><input asp-for="Eposta" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Adres</label><input asp-for="Adres" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Mühendis sayısı</label><input asp-for="MuhendisSayisi" class="form-control" /></div>
            <div class="mb-3"><label class="form-label">Mühendisin mezun olduğu bölüm (5'ten azsa zorunlu)</label><input asp-for="MuhendisBolumu" class="form-control" /></div>
            
            <div class="mb-2">
                <label class="form-label">Haftalık staj günleri</label><br />
                @* value'lar DayOfWeek adlarıyla aynı olmalı, model bağlama bu adlara bakıyor *@
                <label class="me-2"><input type="checkbox" name="HaftalikGunler" value="Monday" /> Pzt</label>
                <label class="me-2"><input type="checkbox" name="HaftalikGunler" value="Tuesday" /> Sal</label>
                <label class="me-2"><input type="checkbox" name="HaftalikGunler" value="Wednesday" /> Çar</label>
                <label class="me-2"><input type="checkbox" name="HaftalikGunler" value="Thursday" /> Per</label>
                <label class="me-2"><input type="checkbox" name="HaftalikGunler" value="Friday" /> Cum</label>
                <label class="me-2"><input type="checkbox" name="HaftalikGunler" value="Saturday" /> Cmt</label>
            </div>
            <div class="mb-3">
                <label class="form-label">Belgede yazan toplam staj günü</label>
                <input asp-for="BelgedekiGunSayisi" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Yükle ve Kontrol Et</button>

        </form>
    </div>
</div>